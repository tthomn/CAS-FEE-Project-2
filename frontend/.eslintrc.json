{
  "extends": ["react-app", "react-app/jest", "plugin:prettier/recommended"],
  "plugins": ["tailwindcss"],
  "rules": {
    "prettier/prettier": "error", // Enforces Prettier rules
    "react/react-in-jsx-scope": "off", // Not needed in React 17+
    "react/prop-types": "off", // Not needed with TypeScript
    "react-hooks/rules-of-hooks": "error", // Checks Rules of Hooks
    "react-hooks/exhaustive-deps": "warn", // Checks effect dependencies
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "warn", // Avoid "any" usage
    "tailwindcss/no-custom-classname": "warn", // Warns if non-Tailwind class names are used
    "tailwindcss/classnames-order": "warn", // Enforces logical class order
    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "alphabetize": { "order": "asc", "caseInsensitive": true }
      }
    ]
  },
  "settings": {
    "react": {
      "version": "detect" // Automatically detects the React version
    },
    "tailwindcss": {
      "callees": ["classnames", "clsx"], // Optional: specify custom className utilities
      "config": "tailwind.config.js" // Path to your Tailwind configuration
    }
  }
}
